# Copy to .env (task setup does it). Never commit .env.
# These values work offline: the fake provider needs no GCP account.

# fake = recorded fixtures, gcp = the real Cloud Run Admin API (needs ADC).
PROVIDER=fake

# Used only with PROVIDER=gcp. Application Default Credentials:
#   gcloud auth application-default login
GCP_PROJECT_ID=
GCP_REGION=us-central1

PORT=8080

# Exact browser origins allowed by CORS, comma separated. Empty = refused.
ALLOWED_ORIGINS=http://localhost:4200

REQUEST_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
LOG_LEVEL=info
LOG_FORMAT=json
